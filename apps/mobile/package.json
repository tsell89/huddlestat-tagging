{
  "name": "@huddlestat/mobile",
  "version": "0.1.0",
  "license": "MIT",
  "description": "HuddleStat iPad play tagging app (Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "dev:lan": "expo start --lan",
    "dev:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/tagging/catchUpHint.test.ts lib/tagging/fieldPosition100.test.ts lib/tagging/jerseyGridRank.test.ts lib/tagging/kickoffRole.test.ts lib/tagging/phaseAdvance.test.ts lib/tagging/playConfig.test.ts lib/tagging/tackleSpot.test.ts lib/sync/publish.test.ts lib/qa/padLabel.test.ts",
    "qa:replay": "npm --prefix ../.. run qa:replay",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@huddlestat/shared": "*",
    "@react-native-community/netinfo": "11.4.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.0",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.9",
    "expo-sharing": "~14.0.0",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
