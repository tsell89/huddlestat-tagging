{
  "name": "huddlestat-tagging",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source iPad football play tagging — Hudl-compatible CSV export",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@huddlestat/mobile",
    "dev:mobile": "npm run dev --workspace=@huddlestat/mobile",
    "dev:mobile:clear": "npm run dev:clear --workspace=@huddlestat/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@huddlestat/shared && npm run test --workspace=@huddlestat/mobile",
    "lint": "echo 'no lint configured'"
  },
  "devDependencies": {
    "babel-preset-expo": "~54.0.10",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@types/react": "^19.1.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  }
}
